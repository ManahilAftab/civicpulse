# Copy to .env (never commit .env):   cp .env.example .env

POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=civicpulse

# Triage provider: rules (no key needed) | llm (Groq) | ollama | simulated
TRIAGE_PROVIDER=rules
# Needed only when TRIAGE_PROVIDER=llm. Get one free at console.groq.com
GROQ_API_KEY=

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_S=60

# compose.prod.yaml only: the commit SHA to deploy (never "latest")
IMAGE_TAG=
